<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/qw_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_shape"
        android:contentDescription="@null"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/qw_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="@string/qw_title"
                android:textColor="#c8f135"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/qw_cfg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="2dp"
                android:text="⚙"
                android:textColor="#a0a0a0"
                android:textSize="16sp"/>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/qw_write"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="8dp">

            <ImageView
                android:id="@+id/qw_pill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/widget_pill_shape"
                android:contentDescription="@null"/>

            <TextView
                android:id="@+id/qw_write_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/qw_write"
                android:textColor="#f2f2f2"
                android:textSize="14sp"/>
        </FrameLayout>
        <ListView
            android:id="@+id/qw_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/qw_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="40"
            android:textColor="#d8d8d8"
            android:textSize="13sp"/>

    </LinearLayout>
</FrameLayout>
