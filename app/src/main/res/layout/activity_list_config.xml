<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#262624"
    android:fillViewport="true">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/l_cfg_title"
        android:textColor="#f2f2f2"
        android:textSize="20sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/l_cfg_what"
        android:textColor="#a0a0a0"
        android:textSize="12sp"
        android:textStyle="bold"/>

    <RadioGroup
        android:id="@+id/lc_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <RadioButton
            android:id="@+id/lc_mode_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/l_mode_all"
            android:textColor="#f2f2f2"/>
        <RadioButton
            android:id="@+id/lc_mode_recent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/l_mode_recent"
            android:textColor="#f2f2f2"/>
        <RadioButton
            android:id="@+id/lc_mode_pinned"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/l_mode_pinned"
            android:textColor="#f2f2f2"/>
        <RadioButton
            android:id="@+id/lc_mode_memory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/l_mode_memory"
            android:textColor="#f2f2f2"/>
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/cfg_style"
        android:textColor="#a0a0a0"
        android:textSize="12sp"
        android:textStyle="bold"/>

    <RadioGroup
        android:id="@+id/lc_style"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <RadioButton
            android:id="@+id/lc_style_gray"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cfg_style_gray"
            android:textColor="#f2f2f2"/>
        <RadioButton
            android:id="@+id/lc_style_dark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cfg_style_dark"
            android:textColor="#f2f2f2"/>
        <RadioButton
            android:id="@+id/lc_style_light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cfg_style_light"
            android:textColor="#f2f2f2"/>
        <RadioButton
            android:id="@+id/lc_style_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cfg_style_clear"
            android:textColor="#f2f2f2"/>
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/cfg_opacity"
        android:textColor="#a0a0a0"
        android:textSize="12sp"
        android:textStyle="bold"/>

    <SeekBar
        android:id="@+id/lc_opacity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="92"/>

    <Button
        android:id="@+id/lc_save"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/cfg_btn_bg"
        android:text="@string/cfg_save"
        android:textColor="#0f0f0f"
        android:textStyle="bold"/>
</LinearLayout>
</ScrollView>
