<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/q_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="48dp"
        android:background="@drawable/quick_card_bg"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/q_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:hint="@string/q_title_hint"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:textColor="#f2f2f2"
            android:textColorHint="#8a8a8a"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#3a3936"/>

        <EditText
            android:id="@+id/q_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="3"
            android:maxLines="8"
            android:gravity="top|start"
            android:background="@null"
            android:hint="@string/q_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textColor="#f2f2f2"
            android:textColorHint="#8a8a8a"
            android:textSize="16sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/q_cancel"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/q_cancel"
                android:textColor="#a0a0a0"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/q_save"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/q_save"
                android:textColor="#0f0f0f"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="10dp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
